{
    "compilerOptions":  {
                            "strict":  true,
                            "noUncheckedIndexedAccess":  true,
                            "exactOptionalPropertyTypes":  true,
                            "module":  "NodeNext",
                            "moduleResolution":  "NodeNext",
                            "target":  "ES2023",
                            "rootDir":  ".",
                            "outDir":  "dist",
                            "verbatimModuleSyntax":  true,
                            "rewriteRelativeImportExtensions":  true,
                            "erasableSyntaxOnly":  true,
                            "declaration":  false,
                            "allowJs":  true,
                            "checkJs":  true,
                            "skipLibCheck":  true,
                            "types":  [
                                          "node"
                                      ]
                        },
    "include":  [
                    "src/**/*.ts",
                    "bin/**/*.ts",
                    "scripts/**/*.ts",
                    "tools/swarm/**/*.ts",
                    "templates/*/manifest.js",
                    "templates/*/deps.js"
                ]
}
