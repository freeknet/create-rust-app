{
  "name": "create-rust-app",
  "version": "0.1.0",
  "description": "Scaffold Rust projects (CLI, GUI, TUI, library, workspace) with strict lints, CI, release automation and a house style — in a very colourful terminal.",
  "type": "module",
  "bin": {
    "create-rust-app": "./dist/bin/create-rust-app.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "check": "node scripts/scaffold-check.ts"
  },
  "keywords": [
    "rust",
    "cargo",
    "scaffold",
    "create",
    "template",
    "egui",
    "cli",
    "generator"
  ],
  "author": "Lawrence Norton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeknet/create-rust-app.git"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@types/node": "^26.6.6",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "typescript": "^7.0.2"
  }
}
