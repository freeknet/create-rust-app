{
  "name": "create-rust-app",
  "version": "0.1.0",
  "description": "Scaffold Rust projects (CLI, GUI, TUI, library, workspace) with strict lints, CI, release automation and a house style — in a very colourful terminal.",
  "type": "module",
  "bin": {
    "create-rust-app": "./bin/create-rust-app.js"
  },
  "files": [
    "bin",
    "src",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/",
    "check": "node scripts/scaffold-check.mjs",
    "swarm": "node tools/swarm/swarm.mjs"
  },
  "keywords": [
    "rust",
    "cargo",
    "scaffold",
    "create",
    "template",
    "egui",
    "cli",
    "generator"
  ],
  "author": "Lawrence Norton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnorton89/create-rust-app.git"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "picocolors": "^1.1.1"
  }
}
